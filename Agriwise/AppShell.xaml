<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Agriwise.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Agriwise.Views"
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarBackgroundColor="#FFFFFF"
    Shell.TabBarForegroundColor="#013A13"
    Shell.TabBarUnselectedColor="#71796F"
    Shell.TabBarTitleColor="#013A13"
    Title="AgriWise">

    <!-- Professional TabBar with official vector icons -->
    <TabBar>
        <Tab Title="Accueil" Icon="ic_home.png">
            <ShellContent
                Title="Accueil"
                ContentTemplate="{DataTemplate views:DashboardPage}"
                Route="DashboardPage" />
        </Tab>

        <Tab Title="Journal" Icon="ic_book.png">
            <ShellContent
                Title="Journal"
                ContentTemplate="{DataTemplate views:JournalPage}"
                Route="JournalPage" />
        </Tab>

        <Tab Title="Guide Santé" Icon="ic_shield.png">
            <ShellContent
                Title="Guide Santé"
                ContentTemplate="{DataTemplate views:HealthGuidePage}"
                Route="HealthGuidePage" />
        </Tab>

        <Tab Title="Exploitation" Icon="ic_chart.png">
            <ShellContent
                Title="Exploitation"
                ContentTemplate="{DataTemplate views:FinancesPage}"
                Route="FinancesPage" />
        </Tab>
    </TabBar>

</Shell>
