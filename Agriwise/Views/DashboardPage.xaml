<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Agriwise.Views.DashboardPage"
             BackgroundColor="#F8F9FA"
             Title="Accueil">

    <ScrollView>
        <VerticalStackLayout Spacing="18" Padding="16,20,16,28" MaximumWidthRequest="500" HorizontalOptions="Center">
            
            <!-- TOP APP BAR / WEATHER & NOTIFICATIONS -->
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label x:Name="UserLocationLabel" Text="Foumbot, Ouest" FontSize="22" FontFamily="OpenSansSemibold" TextColor="#013A13"/>
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Image Source="ic_sun.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center"/>
                        <Label Text="26°C · Risque pluie 15h" FontSize="12" TextColor="#414940" FontFamily="OpenSansSemibold"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Notifications Button with Badge 2 -->
                <Grid Grid.Column="1" WidthRequest="44" HeightRequest="44">
                    <Border StrokeShape="RoundRectangle 14" BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1">
                        <ImageButton Source="ic_bell.png" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" BackgroundColor="Transparent" Clicked="OnNotificationsClicked"/>
                    </Border>
                    <!-- Urgent Red Badge -->
                    <Border x:Name="NotificationBadge" HorizontalOptions="End" VerticalOptions="Start" TranslationX="4" TranslationY="-4" StrokeShape="RoundRectangle 10" BackgroundColor="#BA1A1A" WidthRequest="18" HeightRequest="18">
                        <Label Text="1" FontSize="10" TextColor="White" FontFamily="OpenSansSemibold" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                </Grid>
            </Grid>

            <!-- HERO SAFETY ALERT CARD (Pre-Harvest Interval / DAR Active) -->
            <Border x:Name="DarBannerBorder" StrokeShape="RoundRectangle 16" BackgroundColor="White" Stroke="#FAD7B2" StrokeThickness="1.5" Padding="16">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <!-- Left Anchor Bar Graphic -->
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 12" BackgroundColor="#FEF5EC" StrokeThickness="0" WidthRequest="42" HeightRequest="42" VerticalOptions="Start">
                        <Image Source="ic_alert.png" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Border Grid.Column="0" StrokeShape="RoundRectangle 8" BackgroundColor="#FEF5EC" StrokeThickness="0" Padding="8,3" HorizontalOptions="Start">
                                <Label Text="DAR ACTIF · TOXICITÉ" FontSize="10" FontFamily="OpenSansSemibold" TextColor="#E67E22"/>
                            </Border>
                            <Label x:Name="DarRemainingLabel" Grid.Column="1" Text="J-11 restant" FontSize="13" FontFamily="OpenSansSemibold" TextColor="#E67E22"/>
                        </Grid>

                        <Label x:Name="DarTitleLabel" Text="Délai Avant Récolte (DAR) actif sur Parcelle B — Tomates" FontSize="15" FontFamily="OpenSansSemibold" TextColor="#013A13"/>
                        <Label x:Name="DarDescriptionLabel" Text="Traitement Fongicide appliqué récemment. Récolte interdite pendant encore 11 jours pour éliminer tout résidu toxique." FontSize="12" TextColor="#414940" LineHeight="1.2"/>

                        <!-- DAR Safety Meter Visual -->
                        <Border StrokeShape="RoundRectangle 10" BackgroundColor="#F8F9FA" Stroke="#E5E7EB" StrokeThickness="1" Padding="12,10">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label x:Name="DarDaysMeterLabel" Grid.Column="0" Text="Jour 3 / 14" FontSize="12" FontFamily="OpenSansSemibold" TextColor="#013A13"/>
                                    <Label Grid.Column="1" Text="Phase de dégradation active" FontSize="11" TextColor="#E67E22" FontFamily="OpenSansSemibold"/>
                                </Grid>
                                <!-- Progress bar -->
                                <Grid HeightRequest="7">
                                    <BoxView CornerRadius="3" Color="#E5E7EB" />
                                    <BoxView x:Name="DarProgressBarBox" CornerRadius="3" Color="#E67E22" HorizontalOptions="Start" WidthRequest="80" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label x:Name="DarDateStartLabel" Grid.Column="0" Text="Traitement appliqué" FontSize="10" TextColor="#71796F"/>
                                    <Label x:Name="DarDateEndLabel" Grid.Column="1" Text="Récolte autorisée le 28 Oct." FontSize="10" TextColor="#71796F"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Banner Quick Actions -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                            <Button Grid.Column="0" Text="Voir la parcelle" Clicked="OnOpenParcelBClicked" BackgroundColor="#E67E22" TextColor="White" FontSize="12" FontFamily="OpenSansSemibold" HeightRequest="38" CornerRadius="10"/>
                            <Button Grid.Column="1" Text="Calculateur DAR" Clicked="OnOpenCalculatorClicked" BackgroundColor="White" TextColor="#9C4400" BorderColor="#FAD7B2" BorderWidth="1.5" FontSize="12" FontFamily="OpenSansSemibold" HeightRequest="38" CornerRadius="10"/>
                        </Grid>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- KEY METRICS SUMMARY ROW (3 Bento Cards) -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <!-- Metric 1: Total Plots -->
                <Border Grid.Column="0" StrokeShape="RoundRectangle 14" BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1" Padding="10,12">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="Parcelles actives" FontSize="11" TextColor="#71796F" HorizontalOptions="Center"/>
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label x:Name="TotalPlotsCountLabel" Text="3" FontSize="24" FontFamily="OpenSansSemibold" TextColor="#013A13"/>
                            <Label Text="zones" FontSize="11" TextColor="#71796F" VerticalOptions="End" Margin="0,0,0,4"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Image Source="ic_ruler.png" WidthRequest="12" HeightRequest="12" VerticalOptions="Center"/>
                            <Label x:Name="TotalAreaLabel" Text="4,5 ha total" FontSize="10" TextColor="#1A6D0E" FontFamily="OpenSansSemibold" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Metric 2: Ready Plots -->
                <Border Grid.Column="1" StrokeShape="RoundRectangle 14" BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1" Padding="10,12">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="Prête à récolter" FontSize="11" TextColor="#71796F" HorizontalOptions="Center"/>
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label x:Name="ReadyPlotsCountLabel" Text="2" FontSize="24" FontFamily="OpenSansSemibold" TextColor="#27AE60"/>
                            <Label Text="sécurisée" FontSize="10" TextColor="#71796F" VerticalOptions="End" Margin="0,0,0,4"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Image Source="ic_check.png" WidthRequest="12" HeightRequest="12" VerticalOptions="Center"/>
                            <Label Text="Cacao &amp; Maïs" FontSize="10" TextColor="#27AE60" FontFamily="OpenSansSemibold" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Metric 3: Plots in DAR -->
                <Border Grid.Column="2" StrokeShape="RoundRectangle 14" BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1" Padding="10,12">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="En délai (DAR)" FontSize="11" TextColor="#71796F" HorizontalOptions="Center"/>
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label x:Name="DarPlotsCountLabel" Text="1" FontSize="24" FontFamily="OpenSansSemibold" TextColor="#E67E22"/>
                            <Label Text="en veille" FontSize="10" TextColor="#71796F" VerticalOptions="End" Margin="0,0,0,4"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Image Source="ic_timer.png" WidthRequest="12" HeightRequest="12" VerticalOptions="Center"/>
                            <Label Text="Tomates B" FontSize="10" TextColor="#E67E22" FontFamily="OpenSansSemibold" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- SECTION TITLE: Mes Parcelles & Interventions -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                    <Image Source="ic_wheat.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center"/>
                    <Label Text="Mes Parcelles &amp; Interventions" FontSize="16" FontFamily="OpenSansSemibold" TextColor="#013A13" VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <Border Grid.Column="1" StrokeShape="RoundRectangle 12" BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1" Padding="10,6">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFilterParcelsClicked"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="4">
                        <Image Source="ic_search.png" WidthRequest="12" HeightRequest="12" VerticalOptions="Center"/>
                        <Label Text="Filtrer" FontSize="11" TextColor="#013A13" FontFamily="OpenSansSemibold"/>
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- PARCEL CARDS FEED -->
            <VerticalStackLayout x:Name="ParcelsContainer" Spacing="14">
                
                <!-- PARCEL 1: Cacao (2,5 ha) - Ready -->
                <Border StrokeShape="RoundRectangle 16" BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1" Padding="16,14">
                    <Grid ColumnDefinitions="5,*" ColumnSpacing="12">
                        <!-- Left Crop Indicator Bar -->
                        <BoxView Grid.Column="0" Color="#27AE60" CornerRadius="3" VerticalOptions="FillAndExpand"/>
                        
                        <VerticalStackLayout Grid.Column="1" Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="Parcelle A - Cacao" FontSize="15" FontFamily="OpenSansSemibold" TextColor="#013A13"/>
                                        <Border StrokeShape="RoundRectangle 8" BackgroundColor="#F8F9FA" Stroke="#E5E7EB" StrokeThickness="1" Padding="6,2">
                                            <Label Text="2,5 ha" FontSize="11" TextColor="#414940"/>
                                        </Border>
                                    </HorizontalStackLayout>
                                    <Label Text="Secteur Bas-Fond Nord · Variété Forastero" FontSize="11" TextColor="#71796F"/>
                                </VerticalStackLayout>
                                
                                <Border Grid.Column="1" StrokeShape="RoundRectangle 12" BackgroundColor="#EAF7EE" StrokeThickness="0" Padding="8,4">
                                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                        <Image Source="ic_check.png" WidthRequest="12" HeightRequest="12" VerticalOptions="Center"/>
                                        <Label Text="Récolte autorisée" FontSize="11" TextColor="#27AE60" FontFamily="OpenSansSemibold" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>

                            <!-- Treatment Detail Box -->
                            <Border StrokeShape="RoundRectangle 10" BackgroundColor="#F8F9FA" Stroke="#E5E7EB" StrokeThickness="1" Padding="10,8">
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Text="Dernier traitement : Fumier organique" FontSize="11" TextColor="#414940"/>
                                        <Label Grid.Column="1" Text="18 Septembre" FontSize="11" TextColor="#71796F"/>
                                    </Grid>
                                    <Label Text="Sécurité résidus : Conforme norme zéro délai" FontSize="11" TextColor="#1A6D0E" FontFamily="OpenSansSemibold"/>
                                </VerticalStackLayout>
                            </Border>

                            <Grid ColumnDefinitions="*,Auto">
                                <HorizontalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                    <Label Text="Détails parcelles" FontSize="12" FontFamily="OpenSansSemibold" TextColor="#013A13" VerticalOptions="Center"/>
                                    <Image Source="ic_arrow_forward.png" WidthRequest="14" HeightRequest="14" VerticalOptions="Center"/>
                                    <HorizontalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnOpenParcelBClicked"/>
                                    </HorizontalStackLayout.GestureRecognizers>
                                </HorizontalStackLayout>
                                <Button Grid.Column="1" Text="Journal de récolte" Clicked="OnOpenJournalClicked" BackgroundColor="#F8F9FA" TextColor="#013A13" BorderColor="#E5E7EB" BorderWidth="1" FontSize="11" HeightRequest="36" CornerRadius="8"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- PARCEL 2: Tomate Maraîchère (0,8 ha) - Under DAR Quarantine -->
                <Border StrokeShape="RoundRectangle 16" BackgroundColor="White" Stroke="#FAD7B2" StrokeThickness="1.5" Padding="16,14">
                    <Grid ColumnDefinitions="5,*" ColumnSpacing="12">
                        <!-- Left Crop Indicator Bar Amber -->
                        <BoxView Grid.Column="0" Color="#E67E22" CornerRadius="3" VerticalOptions="FillAndExpand"/>
                        
                        <VerticalStackLayout Grid.Column="1" Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="Parcelle B - Tomate Maraîchère" FontSize="15" FontFamily="OpenSansSemibold" TextColor="#013A13"/>
                                        <Border StrokeShape="RoundRectangle 8" BackgroundColor="#F8F9FA" Stroke="#E5E7EB" StrokeThickness="1" Padding="6,2">
                                            <Label Text="0,8 ha" FontSize="11" TextColor="#414940"/>
                                        </Border>
                                    </HorizontalStackLayout>
                                    <Label Text="Planche d'irrigation 2 · Variété Cobra F1" FontSize="11" TextColor="#71796F"/>
                                </VerticalStackLayout>
                                
                                <Border Grid.Column="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FEF5EC" StrokeThickness="0" Padding="8,4">
                                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                        <Image Source="ic_timer.png" WidthRequest="12" HeightRequest="12" VerticalOptions="Center"/>
                                        <Label x:Name="ParcelBDarPillLabel" Text="En attente - 11j restants" FontSize="11" TextColor="#E67E22" FontFamily="OpenSansSemibold" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>

                            <!-- Chemical Safety Box -->
                            <Border StrokeShape="RoundRectangle 10" BackgroundColor="#FEF5EC" Stroke="#FAD7B2" StrokeThickness="1" Padding="10,8">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label x:Name="ParcelBProductLabel" Text="Fongicide Mancozèbe 80 WP" FontSize="12" FontFamily="OpenSansSemibold" TextColor="#E67E22"/>
                                        <Border Grid.Column="1" StrokeShape="RoundRectangle 6" BackgroundColor="White" Stroke="#FAD7B2" StrokeThickness="1" Padding="6,2">
                                            <Label Text="Dose : 150g/pulv (Respectée)" FontSize="10" TextColor="#E67E22" FontFamily="OpenSansSemibold"/>
                                        </Border>
                                    </Grid>
                                    <Label Text="Délai Avant Récolte obligatoire : 14 jours pleins." FontSize="11" TextColor="#414940"/>
                                    <!-- Progression -->
                                    <Grid HeightRequest="6">
                                        <BoxView CornerRadius="3" Color="#E5E7EB" />
                                        <BoxView CornerRadius="3" Color="#E67E22" HorizontalOptions="Start" WidthRequest="65" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <Grid ColumnDefinitions="*,Auto">
                                <HorizontalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                    <Image Source="ic_alert.png" WidthRequest="12" HeightRequest="12" VerticalOptions="Center"/>
                                    <Label Text="Vente marché bloquée" FontSize="11" TextColor="#BA1A1A" FontFamily="OpenSansSemibold" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                                <Button Grid.Column="1" Text="Fiche intrant" Clicked="OnOpenParcelBClicked" BackgroundColor="#FEF5EC" TextColor="#E67E22" BorderColor="#FAD7B2" BorderWidth="1" FontSize="11" HeightRequest="36" CornerRadius="8"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- PARCEL 3: Maïs Hybride (1,2 ha) - Growth Stage -->
                <Border StrokeShape="RoundRectangle 16" BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1" Padding="16,14">
                    <Grid ColumnDefinitions="5,*" ColumnSpacing="12">
                        <!-- Left Crop Indicator Bar Green -->
                        <BoxView Grid.Column="0" Color="#013A13" CornerRadius="3" VerticalOptions="FillAndExpand"/>
                        
                        <VerticalStackLayout Grid.Column="1" Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="Parcelle C - Maïs Hybride" FontSize="15" FontFamily="OpenSansSemibold" TextColor="#013A13"/>
                                        <Border StrokeShape="RoundRectangle 8" BackgroundColor="#F8F9FA" Stroke="#E5E7EB" StrokeThickness="1" Padding="6,2">
                                            <Label Text="1,2 ha" FontSize="11" TextColor="#414940"/>
                                        </Border>
                                    </HorizontalStackLayout>
                                    <Label Text="Versant Sud · Variété CMS 8704" FontSize="11" TextColor="#71796F"/>
                                </VerticalStackLayout>
                                
                                <Border Grid.Column="1" StrokeShape="RoundRectangle 12" BackgroundColor="#EAF7EE" StrokeThickness="0" Padding="8,4">
                                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                        <Image Source="ic_leaf.png" WidthRequest="12" HeightRequest="12" VerticalOptions="Center"/>
                                        <Label Text="Stade floraison" FontSize="11" TextColor="#14532D" FontFamily="OpenSansSemibold" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>

                            <!-- Advisory Notice Box -->
                            <Border StrokeShape="RoundRectangle 10" BackgroundColor="#F8F9FA" Stroke="#E5E7EB" StrokeThickness="1" Padding="10,8">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="Action conseillée : Prochain désherbage dans 4 jours" FontSize="11" FontFamily="OpenSansSemibold" TextColor="#013A13"/>
                                    <Label Text="Humidité du sol favorable. Privilégier un sarclage manuel avant l'épiaison finale." FontSize="10" TextColor="#71796F"/>
                                </VerticalStackLayout>
                            </Border>

                            <Grid ColumnDefinitions="*,Auto">
                                <HorizontalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                    <Label Text="Guide d'entretien" FontSize="12" FontFamily="OpenSansSemibold" TextColor="#013A13" VerticalOptions="Center"/>
                                    <Image Source="ic_arrow_forward.png" WidthRequest="14" HeightRequest="14" VerticalOptions="Center"/>
                                    <HorizontalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnOpenParcelBClicked"/>
                                    </HorizontalStackLayout.GestureRecognizers>
                                </HorizontalStackLayout>
                                <Button Grid.Column="1" Text="Planifier tâche" Clicked="OnOpenJournalClicked" BackgroundColor="#F8F9FA" TextColor="#013A13" BorderColor="#E5E7EB" BorderWidth="1" FontSize="11" HeightRequest="36" CornerRadius="8"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

            </VerticalStackLayout>

            <!-- QUICK FIELD UTILITY BANNER -->
            <Border StrokeShape="RoundRectangle 16" BackgroundColor="#013A13" Padding="16">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                        <Label Text="Conseiller Agricole Dédié" FontSize="14" FontFamily="OpenSansSemibold" TextColor="White"/>
                        <Label Text="Centre Polyvalent de Foumbot • En ligne" FontSize="11" TextColor="#B8F1B9"/>
                    </VerticalStackLayout>
                    <Button Grid.Row="0" Grid.Column="1" Text="Appeler" Clicked="OnCallAdvisorClicked" BackgroundColor="#27AE60" TextColor="White" FontSize="12" FontFamily="OpenSansSemibold" HeightRequest="36" CornerRadius="8" Padding="14,0"/>
                    
                    <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,14,0,0">
                        <Button Grid.Column="0" Text="Noter Travail" Clicked="OnOpenJournalClicked" BackgroundColor="#1E5128" TextColor="White" FontSize="12" HeightRequest="40" CornerRadius="10"/>
                        <Button Grid.Column="1" Text="Calculer Traitement" Clicked="OnOpenCalculatorClicked" BackgroundColor="#A1F889" TextColor="#012200" FontFamily="OpenSansSemibold" FontSize="12" HeightRequest="40" CornerRadius="10"/>
                    </Grid>
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
