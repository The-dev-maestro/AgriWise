<?xml version="1.0" encoding="utf-8" ?>
<ContentPage Shell.NavBarIsVisible="False" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Agriwise.Views.LoginPage"
             BackgroundColor="#F8F9FA"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="20,24,20,32" MaximumWidthRequest="500" HorizontalOptions="Center">
            
            <!-- TOP ACTION / CONTEXT BAR -->
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center" Margin="0,0,0,6">
                <!-- Back Button -->
                <Border Grid.Column="0" StrokeShape="RoundRectangle 14" BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1" WidthRequest="44" HeightRequest="44">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackClicked"/>
                    </Border.GestureRecognizers>
                    <Image Source="ic_back.png" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <!-- Brand Indicator -->
                <Border Grid.Column="1" HorizontalOptions="Center" StrokeShape="RoundRectangle 20" BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1" Padding="14,6">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Image Source="ic_shield.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center"/>
                        <Label Text="AgriWise" FontSize="15" FontFamily="OpenSansSemibold" TextColor="#013A13" VerticalOptions="Center"/>
                        <BoxView WidthRequest="6" HeightRequest="6" CornerRadius="3" Color="#27AE60" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Offline Ready Indicator -->
                <Border Grid.Column="2" StrokeShape="RoundRectangle 14" BackgroundColor="#EAF7EE" Stroke="#A1F889" StrokeThickness="1" WidthRequest="44" HeightRequest="44">
                    <Image Source="ic_check.png" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
            </Grid>

            <!-- SCREEN HEADING & SUBTITLE -->
            <VerticalStackLayout Spacing="6" Margin="0,4,0,4">
                <Border HorizontalOptions="Start" StrokeShape="RoundRectangle 12" BackgroundColor="#EAF7EE" StrokeThickness="0" Padding="10,4">
                    <HorizontalStackLayout Spacing="6">
                        <Image Source="ic_shield.png" WidthRequest="12" HeightRequest="12" VerticalOptions="Center"/>
                        <Label Text="Accès Planteur &amp; Coopérative" FontSize="11" TextColor="#14532D" FontFamily="OpenSansSemibold" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
                <Label Text="Connexion au carnet" FontSize="26" FontFamily="OpenSansSemibold" TextColor="#013A13" Margin="0,2,0,0"/>
                <Label Text="Accédez à vos parcelles et calculs de doses sécurisés." FontSize="14" TextColor="#414940"/>
            </VerticalStackLayout>

            <!-- AUTHENTICATION & FORM CARD CONTAINER -->
            <VerticalStackLayout Spacing="14">
                
                <!-- Field 1: Phone Number with CMR Flag & High Contrast Input -->
                <Border StrokeShape="RoundRectangle 16" BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1" Padding="16,14">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <HorizontalStackLayout Grid.Column="0" Spacing="6">
                                <Image Source="ic_phone.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center"/>
                                <Label Text="Numéro de téléphone" FontSize="13" FontFamily="OpenSansSemibold" TextColor="#013A13" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Label Grid.Column="1" Text="Orange / MTN" FontSize="11" TextColor="#71796F" VerticalOptions="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <!-- CMR Flag & Prefix -->
                            <Border Grid.Column="0" StrokeShape="RoundRectangle 10" BackgroundColor="#F8F9FA" Stroke="#E5E7EB" StrokeThickness="1" Padding="10,8">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Image Source="ic_flag_cmr.png" WidthRequest="20" HeightRequest="14" VerticalOptions="Center"/>
                                    <Label Text="+237" FontSize="13" FontFamily="OpenSansSemibold" TextColor="#013A13" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Border>
                            <!-- Input -->
                            <Border Grid.Column="1" StrokeShape="RoundRectangle 10" BackgroundColor="#F8F9FA" Stroke="#E5E7EB" StrokeThickness="1" Padding="12,4">
                                <Entry x:Name="PhoneEntry" Placeholder="6XX XX XX XX" Keyboard="Telephone" FontSize="15" TextColor="#013A13"/>
                            </Border>
                        </Grid>
                        <Label Text="Exemple : 670 12 34 56 ou 699 88 77 66" FontSize="11" TextColor="#71796F"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Field 2: Region / Locality Dropdown Selector -->
                <Border StrokeShape="RoundRectangle 16" BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1" Padding="16,14">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="6">
                            <Image Source="ic_location.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center"/>
                            <Label Text="Bassin Agricole &amp; Localité" FontSize="13" FontFamily="OpenSansSemibold" TextColor="#013A13" VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <Border StrokeShape="RoundRectangle 10" BackgroundColor="#F8F9FA" Stroke="#E5E7EB" StrokeThickness="1" Padding="10,2">
                            <Picker x:Name="RegionPicker" Title="Sélectionnez votre région" TextColor="#013A13" FontSize="13">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Région de l'Ouest — Bafoussam / Foumbot</x:String>
                                        <x:String>Centre — Yaoundé / Obala / Mbalmayo</x:String>
                                        <x:String>Littoral — Nkongsamba / Loum / Mbanga</x:String>
                                        <x:String>Sud-Ouest — Buea / Kumba</x:String>
                                        <x:String>Nord-Ouest — Bamenda / Ndop</x:String>
                                        <x:String>Adamaoua — Meiganga / Tibati</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                                <Picker.SelectedIndex>0</Picker.SelectedIndex>
                            </Picker>
                        </Border>
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Image Source="ic_shield.png" WidthRequest="12" HeightRequest="12" VerticalOptions="Center"/>
                            <Label Text="Adapte les conseils météo et alertes locales du MINADER." FontSize="11" TextColor="#1A6D0E" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Field 3: Crops Selection Tags -->
                <Border StrokeShape="RoundRectangle 16" BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1" Padding="16,14">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <HorizontalStackLayout Grid.Column="0" Spacing="6">
                                <Image Source="ic_leaf.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center"/>
                                <Label Text="Cultures sur vos parcelles" FontSize="13" FontFamily="OpenSansSemibold" TextColor="#013A13" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Label Grid.Column="1" Text="Choix multiple" FontSize="11" TextColor="#71796F" VerticalOptions="Center"/>
                        </Grid>

                        <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start">
                            <!-- Active: Tomate -->
                            <Border StrokeShape="RoundRectangle 16" BackgroundColor="#EAF7EE" Stroke="#1E5128" StrokeThickness="1.5" Padding="12,6" Margin="0,0,8,8">
                                <HorizontalStackLayout Spacing="6">
                                    <Image Source="ic_check.png" WidthRequest="12" HeightRequest="12" VerticalOptions="Center"/>
                                    <Label Text="Tomate" FontSize="12" FontFamily="OpenSansSemibold" TextColor="#013A13"/>
                                </HorizontalStackLayout>
                            </Border>
                            <!-- Active: Maïs -->
                            <Border StrokeShape="RoundRectangle 16" BackgroundColor="#EAF7EE" Stroke="#1E5128" StrokeThickness="1.5" Padding="12,6" Margin="0,0,8,8">
                                <HorizontalStackLayout Spacing="6">
                                    <Image Source="ic_check.png" WidthRequest="12" HeightRequest="12" VerticalOptions="Center"/>
                                    <Label Text="Maïs" FontSize="12" FontFamily="OpenSansSemibold" TextColor="#013A13"/>
                                </HorizontalStackLayout>
                            </Border>
                            <!-- Inactive: Cacao -->
                            <Border StrokeShape="RoundRectangle 16" BackgroundColor="#F8F9FA" Stroke="#E5E7EB" StrokeThickness="1" Padding="12,6" Margin="0,0,8,8">
                                <Label Text="+ Cacao" FontSize="12" TextColor="#414940"/>
                            </Border>
                            <!-- Inactive: Piment -->
                            <Border StrokeShape="RoundRectangle 16" BackgroundColor="#F8F9FA" Stroke="#E5E7EB" StrokeThickness="1" Padding="12,6" Margin="0,0,8,8">
                                <Label Text="+ Piment" FontSize="12" TextColor="#414940"/>
                            </Border>
                            <!-- Inactive: Maraîchage -->
                            <Border StrokeShape="RoundRectangle 16" BackgroundColor="#F8F9FA" Stroke="#E5E7EB" StrokeThickness="1" Padding="12,6" Margin="0,0,8,8">
                                <Label Text="+ Maraîchage" FontSize="12" TextColor="#414940"/>
                            </Border>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Field 4: PIN Code -->
                <Border StrokeShape="RoundRectangle 16" BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1" Padding="16,14">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <HorizontalStackLayout Grid.Column="0" Spacing="6">
                                <Image Source="ic_lock.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center"/>
                                <Label Text="Code PIN d'accès rapide" FontSize="13" FontFamily="OpenSansSemibold" TextColor="#013A13" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Label Grid.Column="1" Text="4 à 6 chiffres" FontSize="11" TextColor="#1E5128" FontFamily="OpenSansSemibold" VerticalOptions="Center"/>
                        </Grid>

                        <Border StrokeShape="RoundRectangle 10" BackgroundColor="#F8F9FA" Stroke="#E5E7EB" StrokeThickness="1" Padding="12,4">
                            <Entry x:Name="PinEntry" Placeholder="••••" IsPassword="True" Keyboard="Numeric" MaxLength="6" FontSize="18" TextColor="#013A13"/>
                        </Border>
                        <Label Text="Mémorisez ce code pour vous connecter au champ en un clic." FontSize="11" TextColor="#71796F"/>
                    </VerticalStackLayout>
                </Border>

                <!-- ACTION BUTTONS AREA -->
                <VerticalStackLayout Spacing="10" Margin="0,4,0,0">
                    <!-- Primary CTA -->
                    <Button Text="Accéder à mes parcelles"
                            Clicked="OnAccessParcelsClicked"
                            BackgroundColor="#013A13"
                            TextColor="White"
                            FontFamily="OpenSansSemibold"
                            FontSize="15"
                            HeightRequest="52"
                            CornerRadius="14" />

                    <!-- Secondary OTP SMS Option -->
                    <Button Text="Recevoir un code par SMS"
                            Clicked="OnSmsCodeClicked"
                            BackgroundColor="White"
                            TextColor="#013A13"
                            BorderColor="#E5E7EB"
                            BorderWidth="1.5"
                            FontFamily="OpenSansSemibold"
                            FontSize="14"
                            HeightRequest="48"
                            CornerRadius="14" />
                </VerticalStackLayout>

            </VerticalStackLayout>

            <!-- TRUST & SECURITY NOTICE BANNER -->
            <Border StrokeShape="RoundRectangle 16" BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1" Padding="16" Margin="0,6,0,0">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 20" BackgroundColor="#EAF7EE" StrokeThickness="0" WidthRequest="38" HeightRequest="38" VerticalOptions="Start">
                        <Image Source="ic_shield.png" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Confidentialité Agricole Garantie" FontSize="13" FontFamily="OpenSansSemibold" TextColor="#013A13"/>
                        <Label Text="Vos registres de traitement phytosanitaire (DAR) et surfaces de parcelles ne sont jamais partagés sans votre accord." FontSize="11" TextColor="#414940"/>
                        <HorizontalStackLayout Spacing="14" Margin="0,4,0,0">
                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                <Image Source="ic_check.png" WidthRequest="12" HeightRequest="12" VerticalOptions="Center"/>
                                <Label Text="Stockage hors-ligne" FontSize="11" TextColor="#1E5128" FontFamily="OpenSansSemibold" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                <Image Source="ic_lock.png" WidthRequest="12" HeightRequest="12" VerticalOptions="Center"/>
                                <Label Text="Chiffrement local" FontSize="11" TextColor="#1E5128" FontFamily="OpenSansSemibold" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- CAMEROON AGRO EXTENSION SUPPORT LINE -->
            <Label Text="Assistance planteur : +237 680 00 11 22 (Appel gratuit)"
                   FontSize="11"
                   TextColor="#71796F"
                   HorizontalTextAlignment="Center"
                   Margin="0,4,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
