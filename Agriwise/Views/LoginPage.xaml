<?xml version="1.0" encoding="utf-8" ?>
<ContentPage Shell.NavBarIsVisible="False" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Agriwise.Views.LoginPage"
             BackgroundColor="#F5F8F5"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="24,40,24,32">
            
            <!-- Top Header & Language Toggle -->
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Image Source="ic_shield.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center"/>
                    <Label Text="AgriWise" FontSize="20" FontFamily="OpenSansSemibold" TextColor="#103723" VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <Border Grid.Column="1" StrokeShape="RoundRectangle 16" BackgroundColor="#EAF1EB" StrokeThickness="0" Padding="10,6">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Image Source="ic_globe.png" WidthRequest="14" HeightRequest="14" VerticalOptions="Center"/>
                        <Label Text="Français" FontSize="11" TextColor="#103723" FontFamily="OpenSansSemibold"/>
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- Title & Subtitle -->
            <VerticalStackLayout Spacing="6" Margin="0,10,0,0">
                <Label Text="Bienvenue, Planteur" FontSize="28" FontFamily="OpenSansSemibold" TextColor="#103723"/>
                <Label Text="Connectez votre carnet de culture en quelques secondes." FontSize="14" TextColor="#5B6D60"/>
            </VerticalStackLayout>

            <!-- Form Card Container -->
            <Border StrokeShape="RoundRectangle 18" BackgroundColor="White" Stroke="#E1EBE2" StrokeThickness="1" Padding="18">
                <VerticalStackLayout Spacing="16">
                    
                    <!-- Phone Input -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Numéro de Téléphone" FontSize="13" FontFamily="OpenSansSemibold" TextColor="#103723"/>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Border Grid.Column="0" StrokeShape="RoundRectangle 10" BackgroundColor="#F0F4F0" StrokeThickness="0" Padding="12,10">
                                <Label Text="CMR +237" FontSize="13" FontFamily="OpenSansSemibold" TextColor="#103723" VerticalOptions="Center"/>
                            </Border>
                            <Border Grid.Column="1" StrokeShape="RoundRectangle 10" BackgroundColor="#F9FBF9" Stroke="#D2E0D4" StrokeThickness="1" Padding="12,4">
                                <Entry x:Name="PhoneEntry" Placeholder="6XX XX XX XX" Keyboard="Telephone" FontSize="15" TextColor="#103723"/>
                            </Border>
                        </Grid>
                        <Label Text="Exemple : 675 12 34 56 ou 699 88 77 66 (Orange / MTN)" FontSize="11" TextColor="#86998C"/>
                    </VerticalStackLayout>

                    <!-- Region Dropdown -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Région &amp; Bassin Agricole" FontSize="13" FontFamily="OpenSansSemibold" TextColor="#103723"/>
                        <Border StrokeShape="RoundRectangle 10" BackgroundColor="#F9FBF9" Stroke="#D2E0D4" StrokeThickness="1" Padding="12,4">
                            <Picker x:Name="RegionPicker" Title="Sélectionnez votre région" TextColor="#103723" FontSize="14">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Région de l'Ouest — Foumbot / Bafoussam</x:String>
                                        <x:String>Région du Littoral — Moungo / Penja</x:String>
                                        <x:String>Région du Centre — Obala / Sa'a</x:String>
                                        <x:String>Région du Sud-Ouest — Buea / Kumba</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                                <Picker.SelectedIndex>0</Picker.SelectedIndex>
                            </Picker>
                        </Border>
                        <Label Text="Adapte les conseils météo et alertes ravageurs locaux." FontSize="11" TextColor="#86998C"/>
                    </VerticalStackLayout>

                    <!-- Crops Selection -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Cultures principales sur vos parcelles" FontSize="13" FontFamily="OpenSansSemibold" TextColor="#103723"/>
                        <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start">
                            <Border StrokeShape="RoundRectangle 16" BackgroundColor="#86EF7D" StrokeThickness="0" Padding="12,6" Margin="0,0,8,8">
                                <HorizontalStackLayout Spacing="4">
                                    <Image Source="ic_check.png" WidthRequest="12" HeightRequest="12" VerticalOptions="Center"/>
                                    <Label Text="Tomate" FontSize="12" FontFamily="OpenSansSemibold" TextColor="#0B2317"/>
                                </HorizontalStackLayout>
                            </Border>
                            <Border StrokeShape="RoundRectangle 16" BackgroundColor="#86EF7D" StrokeThickness="0" Padding="12,6" Margin="0,0,8,8">
                                <HorizontalStackLayout Spacing="4">
                                    <Image Source="ic_check.png" WidthRequest="12" HeightRequest="12" VerticalOptions="Center"/>
                                    <Label Text="Maïs" FontSize="12" FontFamily="OpenSansSemibold" TextColor="#0B2317"/>
                                </HorizontalStackLayout>
                            </Border>
                            <Border StrokeShape="RoundRectangle 16" BackgroundColor="#F0F4F0" StrokeThickness="0" Padding="12,6" Margin="0,0,8,8">
                                <Label Text="+ Cacao" FontSize="12" TextColor="#5B6D60"/>
                            </Border>
                            <Border StrokeShape="RoundRectangle 16" BackgroundColor="#F0F4F0" StrokeThickness="0" Padding="12,6" Margin="0,0,8,8">
                                <Label Text="+ Piment" FontSize="12" TextColor="#5B6D60"/>
                            </Border>
                            <Border StrokeShape="RoundRectangle 16" BackgroundColor="#F0F4F0" StrokeThickness="0" Padding="12,6" Margin="0,0,8,8">
                                <Label Text="+ Maraîchage" FontSize="12" TextColor="#5B6D60"/>
                            </Border>
                        </FlexLayout>
                    </VerticalStackLayout>

                    <!-- PIN Input -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Code PIN d'accès rapide (4 chiffres)" FontSize="13" FontFamily="OpenSansSemibold" TextColor="#103723"/>
                        <Border StrokeShape="RoundRectangle 10" BackgroundColor="#F9FBF9" Stroke="#D2E0D4" StrokeThickness="1" Padding="12,4">
                            <Entry x:Name="PinEntry" Placeholder="••••" IsPassword="True" Keyboard="Numeric" MaxLength="4" FontSize="16" TextColor="#103723"/>
                        </Border>
                        <Label Text="Mémorisez ce code pour vous connecter au champ sans mot de passe complexe." FontSize="11" TextColor="#86998C"/>
                    </VerticalStackLayout>

                    <!-- Login Button -->
                    <Button Text="Accéder à mes parcelles"
                            Clicked="OnAccessParcelsClicked"
                            BackgroundColor="#103723"
                            TextColor="White"
                            FontFamily="OpenSansSemibold"
                            FontSize="15"
                            HeightRequest="50"
                            CornerRadius="25"
                            Margin="0,8,0,0"/>

                    <Button Text="Recevoir un code par SMS"
                            Clicked="OnSmsCodeClicked"
                            BackgroundColor="Transparent"
                            TextColor="#103723"
                            FontFamily="OpenSansSemibold"
                            FontSize="13"/>
                </VerticalStackLayout>
            </Border>

            <!-- Reassurance Card -->
            <Border StrokeShape="RoundRectangle 14" BackgroundColor="#EAF3EC" Stroke="#CFE2D2" StrokeThickness="1" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Image Source="ic_lock.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center"/>
                        <Label Text="Confidentialité Agricole Garantie" FontSize="13" FontFamily="OpenSansSemibold" TextColor="#103723"/>
                    </HorizontalStackLayout>
                    <Label Text="Vos données de culture restent privées et protégées. Vos registres de traitement phytosanitaire (DAR) et surfaces de parcelles ne sont jamais partagés sans votre accord." FontSize="12" TextColor="#4F6555"/>
                    <HorizontalStackLayout Spacing="16" Margin="0,4,0,0">
                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                            <Image Source="ic_shield.png" WidthRequest="13" HeightRequest="13" VerticalOptions="Center"/>
                            <Label Text="Sauvegarde locale" FontSize="11" TextColor="#226639"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                            <Image Source="ic_phone.png" WidthRequest="13" HeightRequest="13" VerticalOptions="Center"/>
                            <Label Text="100% Hors-Ligne" FontSize="11" TextColor="#226639"/>
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="Assistance planteur : +237 659 89 11 22 (Appel gratuit)"
                   FontSize="12"
                   TextColor="#5B6D60"
                   HorizontalTextAlignment="Center"
                   Margin="0,10,0,10"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
