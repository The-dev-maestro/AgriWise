<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Agriwise.Views.OnboardingPage"
             BackgroundColor="#F8F9FA"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Spacing="22" Padding="24,36,24,32" MaximumWidthRequest="460" HorizontalOptions="Center">
            
            <!-- TOP FIELD CONTEXT BAR -->
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <Border Grid.Column="0" StrokeShape="RoundRectangle 20" BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1" Padding="12,6" HorizontalOptions="Start">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Image Source="ic_location.png" WidthRequest="14" HeightRequest="14" VerticalOptions="Center"/>
                        <Label Text="Ouest, Cameroun" FontSize="11" FontFamily="OpenSansSemibold" TextColor="#013A13" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <Border Grid.Column="1" StrokeShape="RoundRectangle 20" BackgroundColor="#EAF7EE" Stroke="#A1F889" StrokeThickness="1" Padding="10,6">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#27AE60" VerticalOptions="Center"/>
                        <Label Text="Mode Hors-Ligne" FontSize="11" FontFamily="OpenSansSemibold" TextColor="#14532D" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- HERO BRAND CARD -->
            <Border StrokeShape="RoundRectangle 24" BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1" Padding="24,28">
                <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                    
                    <!-- Emblem with Soft Emerald Halo -->
                    <Grid WidthRequest="96" HeightRequest="96" HorizontalOptions="Center">
                        <Border StrokeShape="RoundRectangle 28" BackgroundColor="#EAF7EE" Stroke="#C8E6C9" StrokeThickness="1.5">
                            <Image Source="ic_leaf.png" WidthRequest="46" HeightRequest="46" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <!-- Verified Badge -->
                        <Border HorizontalOptions="End" VerticalOptions="Start" TranslationX="6" TranslationY="-4" StrokeShape="RoundRectangle 10" BackgroundColor="#013A13" Padding="8,3">
                            <Label Text="PRO" FontSize="10" TextColor="#A1F889" FontFamily="OpenSansSemibold" />
                        </Border>
                    </Grid>

                    <!-- Title -->
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="2">
                            <Label Text="Agri" FontSize="36" TextColor="#013A13" FontFamily="OpenSansSemibold" CharacterSpacing="-0.5" />
                            <Label Text="Wise" FontSize="36" TextColor="#1E5128" FontFamily="OpenSansSemibold" CharacterSpacing="-0.5" />
                        </HorizontalStackLayout>
                        <Label Text="Système de Gestion Agricole &amp; DAR" FontSize="12" FontFamily="OpenSansSemibold" TextColor="#1A6D0E" HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <!-- Tagline -->
                    <Label Text="Cultivez sain, dépensez moins, récoltez sans résidus toxiques." 
                           FontSize="14" 
                           TextColor="#414940" 
                           HorizontalTextAlignment="Center" 
                           LineHeight="1.3" />

                    <!-- Offline Sync Status Pill -->
                    <Border StrokeShape="RoundRectangle 14" BackgroundColor="#F8F9FA" Stroke="#E5E7EB" StrokeThickness="1" Padding="14,12" HorizontalOptions="FillAndExpand">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                    <Image Source="ic_verified.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center"/>
                                    <Label Text="Base phytosanitaire MINADER" TextColor="#013A13" FontSize="12" FontFamily="OpenSansSemibold" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                                <Label Grid.Column="1" Text="100% Local" TextColor="#1E5128" FontSize="11" FontFamily="OpenSansSemibold" VerticalOptions="Center"/>
                            </Grid>
                            
                            <!-- High Contrast Progress Bar -->
                            <Grid HeightRequest="6">
                                <BoxView CornerRadius="3" Color="#E5E7EB" />
                                <BoxView CornerRadius="3" Color="#27AE60" HorizontalOptions="Start" WidthRequest="260" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Prêt pour le travail au champ" TextColor="#71796F" FontSize="11" />
                                <Label Grid.Column="1" Text="Actif" TextColor="#27AE60" FontSize="11" FontFamily="OpenSansSemibold" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- 3 VALUE PILLARS (Clean Bento Row) -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <!-- Pillar 1 -->
                <Border Grid.Column="0" StrokeShape="RoundRectangle 16" BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1" Padding="10,14">
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Border StrokeShape="RoundRectangle 12" BackgroundColor="#FEF5EC" StrokeThickness="0" WidthRequest="36" HeightRequest="36" HorizontalOptions="Center">
                            <Image Source="ic_timer.png" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Text="Calcul DAR" FontSize="12" TextColor="#013A13" FontFamily="OpenSansSemibold" HorizontalOptions="Center"/>
                        <Label Text="Zéro résidu" FontSize="10" TextColor="#71796F" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Pillar 2 -->
                <Border Grid.Column="1" StrokeShape="RoundRectangle 16" BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1" Padding="10,14">
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Border StrokeShape="RoundRectangle 12" BackgroundColor="#EAF7EE" StrokeThickness="0" WidthRequest="36" HeightRequest="36" HorizontalOptions="Center">
                            <Image Source="ic_spray.png" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Text="Pulvé 15L" FontSize="12" TextColor="#013A13" FontFamily="OpenSansSemibold" HorizontalOptions="Center"/>
                        <Label Text="Dosage net" FontSize="10" TextColor="#71796F" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Pillar 3 -->
                <Border Grid.Column="2" StrokeShape="RoundRectangle 16" BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1" Padding="10,14">
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Border StrokeShape="RoundRectangle 12" BackgroundColor="#EAF7EE" StrokeThickness="0" WidthRequest="36" HeightRequest="36" HorizontalOptions="Center">
                            <Image Source="ic_chart.png" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Text="Rentabilité" FontSize="12" TextColor="#013A13" FontFamily="OpenSansSemibold" HorizontalOptions="Center"/>
                        <Label Text="+126% ROI" FontSize="10" TextColor="#27AE60" FontFamily="OpenSansSemibold" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- CALLS TO ACTION -->
            <VerticalStackLayout Spacing="10" Margin="0,4,0,0">
                <Button Text="Commencer"
                        Clicked="OnStartClicked"
                        BackgroundColor="#013A13"
                        TextColor="White"
                        FontFamily="OpenSansSemibold"
                        FontSize="15"
                        HeightRequest="52"
                        CornerRadius="14" />

                <Button Text="Connexion planteur"
                        Clicked="OnLoginClicked"
                        BackgroundColor="White"
                        TextColor="#013A13"
                        BorderColor="#E5E7EB"
                        BorderWidth="1.5"
                        FontFamily="OpenSansSemibold"
                        FontSize="14"
                        HeightRequest="50"
                        CornerRadius="14" />

                <!-- Direct Quick Skip to Explore Dashboard -->
                <Button Text="Accéder directement au tableau de bord"
                        Clicked="OnDirectDashboardClicked"
                        BackgroundColor="Transparent"
                        TextColor="#1A6D0E"
                        FontFamily="OpenSansSemibold"
                        FontSize="12"
                        HeightRequest="36" />

                <Label Text="Conforme aux protocoles phytosanitaires du Cameroun"
                       FontSize="11"
                       TextColor="#71796F"
                       HorizontalTextAlignment="Center"
                       Margin="0,2,0,0" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
