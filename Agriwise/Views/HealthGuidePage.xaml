<?xml version="1.0" encoding="utf-8" ?>
<ContentPage Shell.NavBarIsVisible="False" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Agriwise.Views.HealthGuidePage"
             BackgroundColor="#F8F9FA"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16,16,16,36" MaximumWidthRequest="480">
            
            <!-- TOP APP BAR -->
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                    <Border StrokeShape="RoundRectangle 20" BackgroundColor="#1E5128" StrokeThickness="0" WidthRequest="40" HeightRequest="40">
                        <Image Source="ic_person.png" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout Spacing="1">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="AgriWise" FontSize="16" FontFamily="OpenSansSemibold" TextColor="#013A13"/>
                            <Border StrokeShape="RoundRectangle 8" BackgroundColor="#B8F1B9" StrokeThickness="0" Padding="6,2">
                                <Label Text="MINADER" FontSize="9" FontFamily="OpenSansSemibold" TextColor="#002108"/>
                            </Border>
                        </HorizontalStackLayout>
                        <Label Text="Ouest, Cameroun • Base locale à jour" FontSize="10" TextColor="#71796F"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <Border Grid.Column="2" StrokeShape="RoundRectangle 20" BackgroundColor="#EFEEEC" StrokeThickness="0" WidthRequest="38" HeightRequest="38">
                    <ImageButton Source="ic_bell.png" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" BackgroundColor="Transparent"/>
                </Border>
            </Grid>

            <!-- SECTION TITLE -->
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="Guide Santé &amp; Intrants" FontSize="20" FontFamily="OpenSansSemibold" TextColor="#013A13"/>
                    <Label Text="Réglementation phytosanitaire &amp; sécurité des applicateurs au Cameroun." FontSize="11" TextColor="#71796F"/>
                </VerticalStackLayout>
                <Border Grid.Column="1" StrokeShape="RoundRectangle 12" BackgroundColor="#EFEEEC" Stroke="#E4E2E0" StrokeThickness="1" Padding="8,4" VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                        <Image Source="ic_shield.png" WidthRequest="12" HeightRequest="12" VerticalOptions="Center"/>
                        <Label Text="Certifié" FontSize="10" FontFamily="OpenSansSemibold" TextColor="#1A6D0E" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- HEALTH AWARENESS BANNER (DAR 74% ALERT) -->
            <Border StrokeShape="RoundRectangle 12" BackgroundColor="#FEF5EC" Stroke="#E67E22" StrokeThickness="1.5" Padding="14">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 20" BackgroundColor="#FCE8D5" StrokeThickness="0" WidthRequest="38" HeightRequest="38" VerticalOptions="Start">
                        <Image Source="ic_alert.png" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Alerte Sanitaire : Respectez le DAR" FontSize="13" FontFamily="OpenSansSemibold" TextColor="#944100"/>
                            <Label Grid.Column="1" Text="2024-2026" FontSize="9" FontFamily="OpenSansSemibold" TextColor="#873600"/>
                        </Grid>
                        <Label Text="74% des exploitants maraîchers ne respectent pas le délai d'attente avant récolte. Protégez votre santé, vos reins et celle des familles consommatrices." FontSize="11" TextColor="#5C2B05" LineHeight="1.2"/>
                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                            <Image Source="ic_check.png" WidthRequest="10" HeightRequest="10" VerticalOptions="Center"/>
                            <Label Text="Zéro résidu toxique garanti si le délai est scrupuleusement respecté." FontSize="10" TextColor="#873600" FontFamily="OpenSansSemibold" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- QUICK DOSAGE & DAR INTERACTIVE TOOL HERO CARD -->
            <Border StrokeShape="RoundRectangle 14" BackgroundColor="White" Stroke="#E4E2E0" StrokeThickness="1" Padding="14">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="OUTIL PRATIQUE TERRAIN" FontSize="9" FontFamily="OpenSansSemibold" TextColor="#1A6D0E" CharacterSpacing="1"/>
                            <Label Text="Calculateur Pulvérisateur &amp; DAR" FontSize="15" FontFamily="OpenSansSemibold" TextColor="#013A13"/>
                            <Label Text="Ajustez le volume et le dosage exact par pulvérisateur à dos de 15L pour éviter le surdosage toxique." FontSize="11" TextColor="#71796F"/>
                        </VerticalStackLayout>
                        <Border Grid.Column="1" StrokeShape="RoundRectangle 12" BackgroundColor="#EAF7EE" StrokeThickness="0" WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                            <Image Source="ic_spray.png" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" BackgroundColor="#F5F3F1" Padding="10,6">
                        <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                            <Label Text="Capacité pulvé standard :" FontSize="11" TextColor="#414940"/>
                            <Label Text="15 Litres" FontSize="11" FontFamily="OpenSansSemibold" TextColor="#013A13"/>
                        </HorizontalStackLayout>
                        <Button Grid.Column="1" Text="Calculer mon dosage" Clicked="OnOpenCalculatorClicked" BackgroundColor="#013A13" TextColor="White" FontSize="11" HeightRequest="34" CornerRadius="8"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- SEARCH & HORIZONTAL FILTER TABS -->
            <Border StrokeShape="RoundRectangle 10" BackgroundColor="White" Stroke="#E4E2E0" StrokeThickness="1" Padding="12,4">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Image Grid.Column="0" Source="ic_search.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center"/>
                    <Entry x:Name="SearchProductEntry" Placeholder="Rechercher un intrant, ravageur, matière active..." FontSize="12" TextColor="#013A13" TextChanged="OnSearchTextChanged"/>
                </Grid>
            </Border>

            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="6">
                    <Border x:Name="TabTous" StrokeShape="RoundRectangle 16" BackgroundColor="#013A13" StrokeThickness="0" Padding="12,6">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSelectCatTous"/>
                        </Border.GestureRecognizers>
                        <Label x:Name="LabelTabTous" Text="Tous (4)" FontSize="11" FontFamily="OpenSansSemibold" TextColor="White"/>
                    </Border>
                    <Border x:Name="TabFongicides" StrokeShape="RoundRectangle 16" BackgroundColor="White" Stroke="#E4E2E0" StrokeThickness="1" Padding="10,6">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSelectCatFongicides"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#E67E22" VerticalOptions="Center"/>
                            <Label x:Name="LabelTabFongicides" Text="Fongicides" FontSize="11" TextColor="#414940" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                    <Border x:Name="TabInsecticides" StrokeShape="RoundRectangle 16" BackgroundColor="White" Stroke="#E4E2E0" StrokeThickness="1" Padding="10,6">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSelectCatInsecticides"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#BA1A1A" VerticalOptions="Center"/>
                            <Label x:Name="LabelTabInsecticides" Text="Insecticides" FontSize="11" TextColor="#414940" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                    <Border x:Name="TabHerbicides" StrokeShape="RoundRectangle 16" BackgroundColor="White" Stroke="#E4E2E0" StrokeThickness="1" Padding="10,6">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSelectCatHerbicides"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#71796F" VerticalOptions="Center"/>
                            <Label x:Name="LabelTabHerbicides" Text="Herbicides" FontSize="11" TextColor="#414940" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                    <Border x:Name="TabBio" StrokeShape="RoundRectangle 16" BackgroundColor="White" Stroke="#E4E2E0" StrokeThickness="1" Padding="10,6">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSelectCatBio"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#27AE60" VerticalOptions="Center"/>
                            <Label x:Name="LabelTabBio" Text="Engrais bio" FontSize="11" TextColor="#414940" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                </HorizontalStackLayout>
            </ScrollView>

            <Label Text="FICHES INTRANTS HOMOLOGUÉS (MINADER)" FontSize="11" FontFamily="OpenSansSemibold" TextColor="#71796F" CharacterSpacing="1"/>

            <!-- DYNAMIC PRODUCTS CONTAINER -->
            <VerticalStackLayout x:Name="ProductsContainer" Spacing="12">
            </VerticalStackLayout>

            <!-- EMERGENCY HELPLINE -->
            <Border StrokeShape="RoundRectangle 14" BackgroundColor="#FDEDEC" Stroke="#F5B7B1" StrokeThickness="1" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Image Source="ic_alert.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center"/>
                        <Label Text="Urgence Intoxication &amp; Contact Cutané" FontSize="13" FontFamily="OpenSansSemibold" TextColor="#922B21" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <Label Text="En cas de malaise, vertige ou contact oculaire : rincez à l'eau claire pendant 15 minutes et contactez immédiatement :" FontSize="11" TextColor="#78281F"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0" Text="SAMU : 119" Clicked="OnEmergencyCallClicked" BackgroundColor="#C0392B" TextColor="White" FontSize="11" HeightRequest="36" CornerRadius="8"/>
                        <Button Grid.Column="1" Text="Centre Anti-poison" Clicked="OnEmergencyCallClicked" BackgroundColor="White" TextColor="#C0392B" BorderColor="#F5B7B1" BorderWidth="1" FontSize="11" HeightRequest="36" CornerRadius="8"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
