<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Primary">#013A13</Color>
    <Color x:Key="PrimaryDark">#092215</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="Secondary">#1E5128</Color>
    <Color x:Key="SecondaryDarkText">#9880e5</Color>
    <Color x:Key="Tertiary">#1A6D0E</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

    <!-- AgriWise Custom Theme Palette (Stitch: AgriWise Field System) -->
    <Color x:Key="AgriPrimary">#013A13</Color>
    <Color x:Key="AgriPrimaryContainer">#1E5128</Color>
    <Color x:Key="AgriPrimaryDark">#092215</Color>
    <Color x:Key="AgriPrimaryLight">#1C4E32</Color>
    <Color x:Key="AgriPrimaryFixed">#B8F1B9</Color>
    <Color x:Key="AgriPrimaryFixedDim">#9CD49E</Color>
    <Color x:Key="AgriOnPrimary">#FFFFFF</Color>

    <Color x:Key="AgriSecondary">#1A6D0E</Color>
    <Color x:Key="AgriSecondaryLight">#E6FDE3</Color>
    <Color x:Key="AgriSecondaryContainer">#A1F889</Color>
    <Color x:Key="AgriOnSecondaryContainer">#227415</Color>
    
    <Color x:Key="AgriTertiary">#293506</Color>
    <Color x:Key="AgriTertiaryFixed">#D9EAA9</Color>
    <Color x:Key="AgriTertiaryContainer">#3F4C1B</Color>

    <Color x:Key="AgriWarning">#E67E22</Color>
    <Color x:Key="AgriWarningBg">#FEF5EC</Color>
    <Color x:Key="AgriWarningBorder">#FAD7B2</Color>
    <Color x:Key="AgriWarningText">#9C4400</Color>
    <Color x:Key="AgriWarningLight">#FDF2E9</Color>

    <Color x:Key="AgriSuccess">#27AE60</Color>
    <Color x:Key="AgriSuccessBg">#EAF7EE</Color>
    <Color x:Key="AgriSuccessBorder">#86EFAC</Color>
    <Color x:Key="AgriSuccessText">#14532D</Color>

    <Color x:Key="AgriDanger">#D32F2F</Color>
    <Color x:Key="AgriDangerLight">#FDEDEC</Color>
    <Color x:Key="AgriDangerBg">#FDEDEC</Color>

    <Color x:Key="AgriSurface">#FFFFFF</Color>
    <Color x:Key="AgriSurfaceLow">#F5F3F1</Color>
    <Color x:Key="AgriSurfaceContainer">#EFEEEB</Color>
    <Color x:Key="AgriSurfaceHigh">#E9E8E6</Color>
    <Color x:Key="AgriSurfaceDim">#DBDAD8</Color>
    <Color x:Key="AgriBackground">#FBF9F7</Color>
    <Color x:Key="AgriCardBorder">#E2EAE2</Color>
    <Color x:Key="AgriOutline">#71796F</Color>
    <Color x:Key="AgriOutlineVariant">#C1C9BD</Color>

    <Color x:Key="AgriTextPrimary">#1B1C1B</Color>
    <Color x:Key="AgriTextSecondary">#414940</Color>
    <Color x:Key="AgriTextMuted">#71796F</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="AgriPrimaryBrush" Color="{StaticResource AgriPrimary}"/>
    <SolidColorBrush x:Key="AgriPrimaryContainerBrush" Color="{StaticResource AgriPrimaryContainer}"/>
    <SolidColorBrush x:Key="AgriSecondaryBrush" Color="{StaticResource AgriSecondary}"/>
    <SolidColorBrush x:Key="AgriSecondaryContainerBrush" Color="{StaticResource AgriSecondaryContainer}"/>
    <SolidColorBrush x:Key="AgriWarningBrush" Color="{StaticResource AgriWarning}"/>
    <SolidColorBrush x:Key="AgriWarningBgBrush" Color="{StaticResource AgriWarningBg}"/>
    <SolidColorBrush x:Key="AgriSuccessBrush" Color="{StaticResource AgriSuccess}"/>
    <SolidColorBrush x:Key="AgriSuccessBgBrush" Color="{StaticResource AgriSuccessBg}"/>
    <SolidColorBrush x:Key="AgriDangerBrush" Color="{StaticResource AgriDanger}"/>
    <SolidColorBrush x:Key="AgriSurfaceBrush" Color="{StaticResource AgriSurface}"/>
    <SolidColorBrush x:Key="AgriBackgroundBrush" Color="{StaticResource AgriBackground}"/>
    <SolidColorBrush x:Key="AgriTextPrimaryBrush" Color="{StaticResource AgriTextPrimary}"/>
    <SolidColorBrush x:Key="AgriTextSecondaryBrush" Color="{StaticResource AgriTextSecondary}"/>
  </ResourceDictionary>